# Resend API key for delivering Sales Inquiry submissions.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Verified "from" address in your Resend account. Format: "Display Name <inbox@your-domain.com>".
# Falls back to Resend's onboarding@resend.dev sandbox if unset (test only — won't deliver to most inboxes).
INQUIRY_FROM_EMAIL=

# Optional override of the destination address. Defaults to SALES_EMAIL in lib/contactInfo.ts.
INQUIRY_TO_EMAIL=
